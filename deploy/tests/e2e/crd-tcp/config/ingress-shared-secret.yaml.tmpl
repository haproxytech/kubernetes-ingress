---
kind: Ingress
apiVersion: networking.k8s.io/v1
metadata:
  name: http-echo-shared
spec:
  ingressClassName: haproxy
  tls:
    - hosts:
        - {{ .HostShared }}
      secretName: tcp-test-cert
  rules:
    - host: {{ .HostShared }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: http-echo
                port:
                  name: http
